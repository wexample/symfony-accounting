{
  "name": "wexample/symfony-accounting",
  "description": "Accounting for Symfony: ledgers, double-entry bookkeeping, invoices, bank reconciliation, VAT, closing and reports, with country rules in jurisdiction packages",
  "type": "library",
  "license": "MIT",
  "version": "9.0.1",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAccounting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAccounting\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "league/csv": "^9.5",
    "wexample/php-date": ">=2.1.2",
    "wexample/symfony-helpers": ">=19.0.0",
    "wexample/symfony-money": ">=8.0.0",
    "wexample/symfony-geo": ">=8.0.2",
    "wexample/symfony-check": ">=4.0.4",
    "wexample/symfony-payment": ">=5.0.0",
    "wexample/symfony-remote-payment": ">=3.0.4",
    "symfony/security-core": "^7.4 || ^8.0",
    "wexample/symfony-remote-pdf-factory": ">=2.0.4",
    "wexample/symfony-remote-document-reader": ">=2.0.4",
    "wexample/symfony-remote-peppol": ">=2.0.4",
    "wexample/symfony-api": ">=16.0.0",
    "wexample/php-pseudocode": ">=3.0.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "wexample/symfony-media": ">=6.0.0",
    "wexample/symfony-organization": ">=3.0.3",
    "symfony/validator": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}